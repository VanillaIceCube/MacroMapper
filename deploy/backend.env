# Backend
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_SQLITE_PATH=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,macromapper.localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://macromapper.localhost:3001,https://macromapper.localhost,https://macromapper.localhost:8443
DJANGO_CSRF_TRUSTED_ORIGINS=http://macromapper.localhost:3001,https://macromapper.localhost,https://macromapper.localhost:8443
DJANGO_FORCE_SCRIPT_NAME=
DJANGO_FRONTEND_BASE_URL=https://macromapper.localhost
DJANGO_EMAIL_BACKEND=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=
DJANGO_EMAIL_USE_TLS=
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_KEY=
DJANGO_EMAIL_TIMEOUT=
DJANGO_DEFAULT_FROM_EMAIL=
MACROMAPPER_OPENAI_API_KEY=
OPENAI_MEAL_ESTIMATION_MODEL=gpt-5.6-luna
OPENAI_MEAL_ESTIMATION_TIMEOUT=45

# Optional local host-port overrides. Production defaults are 80/443/8000/3000.
MACROMAPPER_HTTP_PORT=
MACROMAPPER_HTTPS_PORT=
MACROMAPPER_BACKEND_PORT=
MACROMAPPER_FRONTEND_PORT=

# Development Compose host-port overrides (localhost-only bindings).
MACROMAPPER_DEV_BACKEND_PORT=8000
MACROMAPPER_DEV_FRONTEND_PORT=3000
